# shared coalescence protocol (included by coalesce.in / coalesce_annealed.in)
mass            1 ${mass}
pair_style      eam
pair_coeff      1 1 ${pot}
neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes
min_style       cg
minimize        1e-10 1e-10 5000 50000
timestep        ${dt}
velocity        all create ${T} ${seed} mom yes rot yes dist gaussian
fix             nvt all nvt temp ${T} ${T} 0.1
fix             mA A momentum 100 linear 1 1 1 angular
fix             mB B momentum 100 linear 1 1 1 angular
thermo          5000
run             ${n_eq}
unfix           mA
unfix           mB
# close the gap (initially gap0 > cutoff) to gap1
displace_atoms  B move -${shift} 0 0 units box
reset_timestep  0
fix             mom all momentum 100 linear 1 1 1 angular
compute         gy all gyration
variable        pea equal pe/atoms
variable        gxx equal c_gy[1]
variable        gyy equal c_gy[2]
variable        gzz equal c_gy[3]
variable        gxy equal c_gy[4]
variable        gxz equal c_gy[5]
variable        gyz equal c_gy[6]
variable        tt equal temp
fix             pr all print ${nprint} "$(time) ${tt} ${pea} ${gxx} ${gyy} ${gzz} ${gxy} ${gxz} ${gyz}" file ${out}.coal.txt screen no title "# time_ps T pe_per_atom gxx gyy gzz gxy gxz gyz"
thermo          10000
run             ${n_run}
write_data      ${out}.final.data
